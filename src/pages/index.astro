---
import "@/styles/global.css";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>rodris-dev</title>
    <!-- Respaldo sin JavaScript: si el script no corre, se va a español -->
    <noscript><meta http-equiv="refresh" content="0; url=/es/" /></noscript>
  </head>
  <body class="grid min-h-screen place-items-center bg-bg font-mono text-sm text-muted">
    <p>
      Redirigiendo / Redirecting…
      <a class="text-accent underline" href="/es/">ES</a> ·
      <a class="text-accent underline" href="/en/">EN</a>
    </p>

    <script>
      import { detectLocale } from "@/i18n/detect";
      location.replace(`/${detectLocale()}/`);
    </script>
  </body>
</html>
