---
import Container from "@/components/ui/Container.astro";
import { getDictionary } from "@/i18n";
import type { Locale } from "@/i18n/config";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDictionary(lang);
const year = new Date().getFullYear();
---

<footer class="mt-10 border-t border-line py-10">
  <Container class="flex flex-col gap-2 font-mono text-xs text-muted sm:flex-row sm:justify-between">
    <p>© {year} rodris.dev</p>
    <p><span class="text-accent-2">●</span> {t.footer.status}</p>
  </Container>
</footer>
