---
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  href?: string;
  variant?: "primary" | "ghost";
  arrow?: boolean;
  class?: string;
}

const { href, variant = "primary", arrow = true, class: className } = Astro.props;
const Tag = href ? "a" : "button";

const variants = {
  primary:
    "bg-linear-to-r from-accent to-accent-2 font-semibold text-accent-ink hover:shadow-[0_0_32px_-4px_var(--accent)]",
  ghost: "glass text-ink hover:border-accent hover:text-accent",
} satisfies Record<NonNullable<Props["variant"]>, string>;
---

<Tag
  href={href}
  type={href ? undefined : "button"}
  data-magnetic={variant === "primary" ? "" : undefined}
  class:list={[
    "group inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm transition-all duration-300",
    "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
    variants[variant],
    className,
  ]}
>
  <slot />
  {arrow && (
    <span class="inline-flex transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
      <ArrowUpRight size={16} aria-hidden="true" />
    </span>
  )}
</Tag>
