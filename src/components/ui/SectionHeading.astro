---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
}
const { index, eyebrow, title, description } = Astro.props;
const tag = eyebrow.toUpperCase();
---

<div class="reveal mb-10 max-w-2xl">
  <p class="mb-3 font-mono text-xs tracking-[0.25em] text-accent">
    [ {index} //
    <span class="sr-only">{tag}</span>
    <span aria-hidden="true" data-scramble={tag}>{tag}</span> ]
  </p>
  <h2 class="font-display text-2xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-base text-muted">{description}</p>}
</div>
