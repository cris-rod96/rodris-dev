---
import { locales, type Locale } from "@/i18n/config";
import { getDictionary } from "@/i18n";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<div role="group" aria-label={t.a11y.language} class="glass flex items-center rounded-full p-0.5 font-mono text-[11px]">
  {locales.map((code) => (
    <a
      href={`/${code}/`}
      hreflang={code}
      lang={code}
      data-set-locale={code}
      aria-current={code === lang ? "true" : undefined}
      class:list={[
        "rounded-full px-2.5 py-1 uppercase tracking-wider transition-colors",
        code === lang ? "bg-accent font-semibold text-accent-ink" : "text-muted hover:text-ink",
      ]}
    >
      {code}
    </a>
  ))}
</div>

<script>
  import { LOCALE_STORAGE_KEY } from "@/i18n/config";

  document.querySelectorAll<HTMLAnchorElement>("[data-set-locale]").forEach((link) => {
    link.addEventListener("click", () => {
      link.hash = location.hash; // conserva la sección en la que estás
      try {
        localStorage.setItem(LOCALE_STORAGE_KEY, link.dataset.setLocale ?? "");
      } catch {
        /* sin almacenamiento: se omite */
      }
    });
  });
</script>
